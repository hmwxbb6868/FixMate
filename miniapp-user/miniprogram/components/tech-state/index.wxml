<view class="state"><van-loading wx:if="{{loading}}" color="#D34B18" size="30px" /><view wx:else class="state-icon {{error?'state-icon--error':''}}"><van-icon name="{{error?'replay':'todo-list-o'}}" size="36px" /></view><view class="state-title">{{loading?'正在同步最新信息':title}}</view><view class="state-description">{{description}}</view><button wx:if="{{!loading&&action}}" class="state-button" bindtap="onAction">{{action}}</button></view>
