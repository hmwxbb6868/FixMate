.state{padding:68rpx 36rpx 58rpx;text-align:center;background:#FFF;border-radius:24rpx;margin:16rpx 0 24rpx;}.state-icon{width:136rpx;height:136rpx;border-radius:44rpx;background:#FFF4EC;color:#D99562;margin:0 auto 28rpx;display:flex;align-items:center;justify-content:center;transform:rotate(-5deg);}.state-icon--error{background:#F2F4F8;color:#8995A7;transform:none;}.state-title{font-size:30rpx;color:#424E5D;font-weight:600;margin-top:22rpx;}.state-description{font-size:25rpx;line-height:1.8;color:#929BA7;margin-top:14rpx;white-space:pre-wrap;}.state-button{display:inline-block;margin:28rpx auto 0;padding:14rpx 32rpx;min-width:180rpx;font-size:26rpx;line-height:1.5;color:#C64B1C;border-radius:32rpx;background:#FFF0E7;}.state-button::after{border:0;}
