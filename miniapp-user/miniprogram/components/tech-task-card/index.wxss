:host {display:block;}.task-card{background:#FFF;border-radius:24rpx;padding:28rpx;margin-bottom:22rpx;box-shadow:0 5rpx 24rpx rgba(27,38,57,.025);}.task-top,.task-device,.task-foot{display:flex;align-items:center;justify-content:space-between;gap:18rpx;}.task-device{justify-content:flex-start;min-width:0;}.device-icon{width:78rpx;height:78rpx;border-radius:22rpx;background:#FFF1E8;color:#D34B18;display:flex;align-items:center;justify-content:center;flex-shrink:0;}.task-title{font-size:30rpx;font-weight:700;line-height:1.5;color:#202835;}.task-no{font-size:19rpx;color:#99A1AD;margin-top:4rpx;max-width:335rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.task-status{font-size:23rpx;font-weight:600;padding:6rpx 12rpx;border-radius:10rpx;white-space:nowrap;}.task-status--orange{background:#FFF0E7;color:#C64B1C;}.task-status--blue{background:#EDF3FF;color:#49699E;}.task-status--muted{background:#F0F1F4;color:#7C8592;}.task-symptom{font-size:27rpx;line-height:1.75;color:#4C5767;margin:24rpx 0 18rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}.task-meta{display:flex;align-items:flex-start;gap:10rpx;font-size:23rpx;color:#8A94A2;line-height:1.6;}.task-meta van-icon{padding-top:3rpx;}.task-foot{border-top:1rpx solid #F0F1F4;margin-top:22rpx;padding-top:22rpx;}.task-meta--time{flex:1;min-width:0;font-size:22rpx;}.task-action{display:flex;align-items:center;gap:8rpx;background:#FFF0E7;color:#C64B1C;font-weight:600;font-size:24rpx;border-radius:32rpx;padding:12rpx 20rpx;flex-shrink:0;}.task-risk{font-size:23rpx;line-height:1.7;color:#A26428;margin-bottom:14rpx;}.task-card:active{opacity:.82;}
