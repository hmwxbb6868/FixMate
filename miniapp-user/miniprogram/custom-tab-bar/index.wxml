<view wx:if="{{!hidden}}" class="tabbar {{workspace === 'TECHNICIAN' ? 'tabbar--technician' : ''}}" aria-role="tablist">
  <view wx:for="{{tabs}}" wx:key="path" class="tabbar__item {{selected === index ? 'tabbar__item--selected' : ''}}" data-index="{{index}}" bindtap="onSelect" aria-role="tab" aria-label="{{item.text}}" aria-selected="{{selected === index}}">
    <van-icon name="{{item.icon}}" size="23px" />
    <text class="tabbar__text">{{item.text}}</text>
    <view wx:if="{{selected === index}}" class="tabbar__marker" />
  </view>
</view>

