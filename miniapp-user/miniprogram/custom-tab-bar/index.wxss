 .tabbar { position:fixed; z-index:100; left:0; right:0; bottom:0; display:flex; height:calc(56px + env(safe-area-inset-bottom)); padding-bottom:env(safe-area-inset-bottom); background:var(--fm-bg-surface, #FFFFFF); border-top:1rpx solid var(--fm-border, #E5E2DB); }
.tabbar__item { position:relative; flex:1; min-height:56px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px; color:var(--fm-text-secondary, #5B6673); }
.tabbar__item--selected { color:var(--fm-action, #BC431A); font-weight:600; }
.tabbar__text { font-size:12px; line-height:18px; }
.tabbar__marker { position:absolute; width:16px; height:2px; top:0; border-radius:0 0 6rpx 6rpx; background:var(--fm-action, #BC431A); }


/* 维修区保留独立的品牌色。 */
.tabbar--technician{background:#FFF;border-top-color:#ECEEF1;box-shadow:0 -6rpx 24rpx rgba(27,38,57,.025);}
.tabbar--technician .tabbar__item--selected{color:#D34B18;}
.tabbar--technician .tabbar__marker{background:#D34B18;border-radius:0 0 6rpx 6rpx;}
