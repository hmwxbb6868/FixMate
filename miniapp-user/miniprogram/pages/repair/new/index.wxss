/* U1 发起报修：只放本页特有样式，通用 Token 在 app.wxss，Vant 主题在 styles/vant-theme.wxss */

.state {
  padding: 200rpx 32rpx;
  text-align: center;
}
.state__text {
  font-size: var(--fm-font-caption);
  line-height: var(--fm-line-caption);
  color: var(--fm-text-secondary);
}
.state__btn {
  margin-top: 40rpx;
}

/* Vant 单元格与输入框：只补分隔线与字号层级，间距交给主题变量 */
.fm-cell,
.fm-field {
  border-bottom: 1rpx solid var(--fm-divider);
}
.fm-cell:last-child {
  border-bottom: none;
}
.fm-cell__title {
  flex: 0 0 auto;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--fm-text-secondary);
}
.fm-cell__value {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--fm-text-primary);
  text-align: right;
  word-break: break-word;
}
.fm-field__label {
  width: 150rpx !important;
  min-width: 150rpx;
  font-size: 26rpx;
  color: var(--fm-text-secondary);
}
.fm-field__input {
  font-size: 30rpx;
  color: var(--fm-text-primary);
}

/* 草稿提示 */
.draft-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
  margin: 0 28rpx 22rpx;
  padding: 24rpx;
  border-radius: var(--fm-radius-md);
  background: var(--fm-action-soft);
}
.draft-banner__text {
  font-size: var(--fm-font-caption);
  color: var(--fm-action);
}
.draft-banner__actions {
  display: flex;
  align-items: center;
  gap: 28rpx;
}
.draft-banner__link {
  font-size: var(--fm-font-caption);
  color: var(--fm-text-secondary);
}
.draft-banner__btn {
  font-size: var(--fm-font-caption);
  font-weight: 600;
  color: var(--fm-action);
}

/* 照片 */
.uploader {
  padding: 16rpx 0 24rpx;
}

/* 安全问答：题目独占一行，选项另起一行等宽排列 */
.qa {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  padding: 26rpx 0 28rpx;
  border-bottom: 1rpx solid var(--fm-divider);
}
.qa:last-of-type {
  border-bottom: none;
}
.qa__label {
  width: 100%;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--fm-text-primary);
  word-break: break-word;
}
.seg {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}
.seg__item {
  flex: 1 1 0;
  min-width: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 2rpx solid var(--fm-border);
  border-radius: var(--fm-radius-md);
  background: #FFFFFF;
  color: var(--fm-text-secondary);
  font-size: 30rpx;
  box-sizing: border-box;
}
.seg__item--hover {
  background: var(--fm-bg-subtle);
}
.seg__item--on {
  background: var(--fm-action-soft);
  border-color: var(--fm-warm-line);
  color: var(--fm-action);
  font-weight: 600;
}
.seg__text {
  line-height: 1;
}

/* 地址内嵌表单 */
.row__v--link {
  color: var(--fm-action);
  font-weight: 500;
}
.addr-form {
  margin-top: 24rpx;
}
.addr-form__contacts,
.addr-form__region,
.addr-form__actions {
  display: flex;
  gap: 16rpx;
}
.addr-form__contacts,
.addr-form__region {
  margin-bottom: 20rpx;
}
.addr-form__field {
  flex: 1 1 0;
  min-width: 0;
}
.addr-form__label {
  display: block;
  margin-bottom: 8rpx;
  font-size: var(--fm-font-caption);
  line-height: var(--fm-line-caption);
  color: var(--fm-text-secondary);
  font-weight: 500;
}
.addr-form__input {
  display: block;
  width: 100%;
  height: 84rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--fm-border);
  border-radius: var(--fm-radius-sm);
  background: var(--fm-bg-subtle);
  font-size: 28rpx;
  color: var(--fm-text-primary);
  box-sizing: border-box;
}
.addr-form__placeholder {
  color: var(--fm-text-tertiary);
  font-size: var(--fm-font-caption);
}
.addr-form__input--detail {
  height: auto;
  min-height: 116rpx;
  padding: 16rpx;
  line-height: var(--fm-line-caption);
}
.addr-form__error {
  margin-top: 8rpx;
}
.addr-form__actions {
  margin-top: 24rpx;
}
.addr-form__button {
  flex: 1 1 0;
  min-width: 0;
  width: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 12rpx 4rpx;
  border: 1rpx solid var(--fm-border);
  border-radius: var(--fm-radius-md);
  background: var(--fm-bg-surface);
  color: var(--fm-text-secondary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: var(--fm-line-caption);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.addr-form__button::after {
  border: 0;
}
.addr-form__button--primary {
  flex-grow: 2;
  border-color: var(--fm-action);
  background: var(--fm-action);
  color: #FFFFFF;
}
.addr-form__button--pressed {
  opacity: .8;
}

/* 让 Vant 组件宿主参与等宽布局，避免内部按钮宽度挤压同排操作。 */
.actionbar > van-button {
  flex: 1;
  min-width: 0;
}
.btn-ghost,
.btn-main {
  font-weight: 600;
}

/* 安全阻断态 */
.alert {
  margin: 0 28rpx 24rpx;
  padding: 30rpx;
  border: 1rpx solid var(--fm-danger-line);
  border-radius: var(--fm-radius-lg);
  background: var(--fm-danger-soft);
}
.alert__tag {
  font-size: var(--fm-font-micro);
  letter-spacing: 2rpx;
  color: var(--fm-danger);
  font-weight: 700;
}
.alert__title {
  margin: 16rpx 0;
  font-size: var(--fm-font-title);
  line-height: var(--fm-line-title);
  font-weight: 600;
}
.alert__lead {
  margin-bottom: 24rpx;
  font-size: var(--fm-font-caption);
  line-height: var(--fm-line-caption);
  color: #4A2A27;
}
.alert__rule {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--fm-danger-line);
}
.alert__rule-title {
  font-size: var(--fm-font-caption);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.alert__rule-text {
  font-size: var(--fm-font-caption);
  line-height: var(--fm-line-caption);
}
.alert__no {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--fm-danger-line);
  font-size: var(--fm-font-micro);
  color: #6B3A36;
}
.alert__no-value {
  font-family: Consolas, "Courier New", monospace;
  font-size: var(--fm-font-caption);
  font-weight: 700;
  color: var(--fm-danger);
  overflow-wrap: anywhere;
  min-width: 0;
}

/* 其它 */
.hint-block {
  padding: 24rpx 0;
  font-size: var(--fm-font-caption);
  line-height: var(--fm-line-caption);
  color: var(--fm-text-secondary);
}
.footnote {
  margin: 0 28rpx 16rpx;
  padding: 0 4rpx;
  font-size: var(--fm-font-caption);
  line-height: 1.55;
  color: var(--fm-text-secondary);
}
.footnote--fee {
  padding: 18rpx 22rpx;
  border-radius: var(--fm-radius-md);
  border: 1rpx solid var(--fm-warm-line);
  background: var(--fm-action-soft);
  color: var(--fm-warm-text);
}
/* 取消报修：只在服务端允许时出现，弱化为次要动作 */
.cancel-link {
  margin-top: 28rpx;
  padding: 20rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--fm-text-tertiary);
}
.saved-hint {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: var(--fm-font-micro);
  color: var(--fm-success);
}

/* 仅新增Tab占位；阻断态沿用原底栏位置与安全区。 */
.page--tab { padding-bottom:calc(220rpx + 56px + env(safe-area-inset-bottom)); }
.page--tab .actionbar { bottom:calc(56px + env(safe-area-inset-bottom)); padding-bottom:20rpx; z-index:80; }
.page--tab .saved-hint { bottom:calc(150rpx + 56px + env(safe-area-inset-bottom)); }

/* 用户复验调整：普通表单操作随内容滚动，不悬浮。 */
.page--form-flow { padding-bottom:calc(72px + env(safe-area-inset-bottom)); }
.page--tab .actionbar--flow { position:static; margin:24rpx 28rpx 18rpx; padding:0; background:transparent; border:0; box-shadow:none; }
.page--form-flow .saved-hint { position:static; padding:0 32rpx 16rpx; }
.safety-back { display:flex; align-items:center; gap:12rpx; min-height:80rpx; padding:0 32rpx 16rpx; color:var(--fm-action); }
