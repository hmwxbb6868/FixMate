@import "../../../styles/technician.wxss";

.visit-page{padding-bottom:200rpx;}.visit-heading{padding:18rpx 2rpx 28rpx;}.visit-symbol{width:96rpx;height:96rpx;border-radius:30rpx;background:#FFF0E3;color:var(--fm-action);display:flex;align-items:center;justify-content:center;margin-bottom:22rpx;}.visit-heading .tech-title{font-size:44rpx;}.visit-heading .tech-subtitle{font-size:25rpx;line-height:1.8;}.visit-current{padding:24rpx 26rpx;border-radius:22rpx;display:flex;align-items:center;gap:20rpx;color:var(--fm-warm-text);background:#FFF2E8;border:1rpx solid #F4E1D4;}.visit-current text{font-size:22rpx;color:var(--fm-warm-text);}.visit-current view view{font-size:27rpx;font-weight:600;line-height:1.6;margin-top:4rpx;}.visit-dates{display:flex;gap:16rpx;padding:4rpx 0 12rpx;}.visit-date{min-width:130rpx;padding:22rpx 12rpx;border-radius:20rpx;background:#FFF;text-align:center;border:2rpx solid transparent;box-sizing:border-box;}.visit-date text{font-size:23rpx;color:var(--fm-text-tertiary);}.visit-date view{font-size:26rpx;font-weight:600;color:#536073;margin-top:8rpx;}.visit-date--selected{background:#FFF2E9;border-color:#E8AA87;}.visit-date--selected text,.visit-date--selected view{color:var(--fm-action);}.visit-periods{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;}.visit-period{border-radius:20rpx;padding:28rpx 18rpx;min-height:98rpx;display:flex;align-items:center;justify-content:center;gap:10rpx;font-size:28rpx;font-weight:600;background:#FFF;border:2rpx solid transparent;color:#5C687A;}.visit-period--selected{border-color:#E29C74;background:#FFF1E7;color:var(--fm-action);}.visit-period--disabled{opacity:.38;}.visit-explanation{margin-top:30rpx;padding:24rpx 4rpx;}.visit-explanation view{display:flex;align-items:flex-start;gap:14rpx;font-size:23rpx;color:var(--fm-text-secondary);line-height:1.8;margin-top:16rpx;}.visit-explanation van-icon{color:#BAA18E;margin-top:5rpx;flex-shrink:0;}

.visit-page {
  --tech-orange:var(--fm-action);
  --tech-muted:var(--fm-text-secondary);
}
