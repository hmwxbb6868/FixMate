@import "../../../styles/technician.wxss";
.catalog-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;}.catalog-head>view{flex:1;min-width:0;}.catalog-name{font-size:29rpx;font-weight:650;margin-bottom:8rpx;}.catalog-head>van-icon{color:#ADB5BF;}.catalog-rule{border-top:1rpx solid #F0F1F4;margin-top:22rpx;padding-top:22rpx;}.catalog-price{display:flex;justify-content:space-between;gap:16rpx;font-size:25rpx;}.catalog-price>text:last-child{font-size:28rpx;font-weight:650;color:#CF571F;}.catalog-unit{font-size:22rpx;font-weight:400;color:#A2AAB5;}.catalog-rule__title{font-size:26rpx;margin:12rpx 0 6rpx;}.catalog-rule__description{font-size:24rpx;line-height:1.8;color:#8994A2;margin-top:12rpx;white-space:pre-wrap;}.catalog-loading{padding-top:24rpx;}
