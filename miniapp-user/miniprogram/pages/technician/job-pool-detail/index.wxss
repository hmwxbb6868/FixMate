@import "../../../styles/technician.wxss";
.pool-detail{padding-bottom:190rpx;}.pool-summary,.pool-flow{padding:32rpx;}.pool-title{font-size:42rpx;font-weight:750;margin-top:24rpx;color:#27303C;}.pool-no,.pool-time{font-size:23rpx;color:#A0A8B4;margin-top:12rpx;}.pool-label{font-size:24rpx;color:#8C98A8;margin-top:32rpx;}.pool-description{font-size:29rpx;color:#4B586B;line-height:1.8;margin-top:8rpx;}.pool-time{border-top:1rpx solid #F1F3F6;padding-top:24rpx;margin-top:28rpx;}.pool-flow view{display:flex;gap:20rpx;align-items:center;font-size:27rpx;color:#647082;padding:15rpx 0;}.pool-flow text{color:#CD7041;background:#FFF3EA;border-radius:12rpx;padding:7rpx 10rpx;font-size:23rpx;}

.pool-slot-confirm{margin-top:26rpx;padding:22rpx 24rpx;background:#FFF4EA;border-radius:18rpx;border:1rpx solid #F6E3D3;}.pool-slot-confirm .pool-label{margin-top:0;color:#AB8468;}.pool-slot-confirm .pool-description{font-size:29rpx;font-weight:650;color:#B36536;}.pool-slot-confirm>text{display:block;font-size:22rpx;color:#B89A86;margin-top:12rpx;}
