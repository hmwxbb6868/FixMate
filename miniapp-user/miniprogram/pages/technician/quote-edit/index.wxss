@import "../../../styles/technician.wxss";
.quote-context{margin:-8rpx 4rpx 22rpx;word-break:break-all;}.line-index{display:flex;align-items:center;gap:14rpx;font-size:28rpx;font-weight:600;}.line-index text{width:42rpx;height:42rpx;display:flex;align-items:center;justify-content:center;background:#FFF0E7;color:#CF5D2D;border-radius:12rpx;font-size:23rpx;}.line-remove{font-size:24rpx;color:#A0A8B4;}.old-line{font-size:23rpx;color:#A0A8B2;line-height:1.8;background:#F7F8FA;padding:16rpx 18rpx;border-radius:12rpx;margin-top:20rpx;}.rule-price{font-size:25rpx;color:#B56D45;margin-top:14rpx;}.line-two{display:flex;gap:24rpx;}.line-two>.tech-field{flex:1;min-width:0;}.expiry-pickers{display:flex;gap:18rpx;}.expiry-pickers>picker:first-child{flex:1.4;}.expiry-pickers>picker:last-child{flex:1;}.add-line{display:flex;justify-content:center;align-items:center;gap:16rpx;width:100%;padding:24rpx;font-size:28rpx;line-height:1.5;font-weight:600;background:transparent;border:1rpx dashed #DAAF95;border-radius:20rpx;color:#B77752;margin:0 0 26rpx;}.amount-hint{display:flex;align-items:flex-start;gap:18rpx;color:#80A38D;margin:28rpx 4rpx;}.amount-hint view view{font-size:26rpx;font-weight:600;color:#6A8775;}.amount-hint text{font-size:23rpx;color:#99AA9D;line-height:1.8;display:block;margin-top:8rpx;}
