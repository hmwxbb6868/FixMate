<view class="tech-page tech-page--detail"><view class="tech-head"><view><view class="tech-eyebrow">QUOTATION</view><view class="tech-title">报价与确认范围</view><view class="tech-subtitle">费用清晰，确认后再服务</view></view></view><tech-state wx:if="{{loading}}" loading /><tech-state wx:elif="{{error}}" error title="报价暂不可用" description="{{error}}" action="重新读取" bind:retry="load" /><block wx:else><view class="tech-caption quote-order">{{orderNo}}</view><view wx:if="{{rejectionFollowUp}}" class="tech-notice">{{rejectionFollowUp==='WAITING_QUOTE'?'客户对报价不满意，平台已要求重新报价。':'客户已拒绝报价，维修已暂停，等待平台协调。'}}</view><view wx:if="{{paused}}" class="tech-notice"><van-icon name="pause-circle-o" /><text>维修已暂停。等待客户确认追加报价后，才能继续维修。</text></view><view wx:if="{{pendingLabel}}" class="tech-notice">“{{pendingLabel}}”结果待确认，请先恢复。</view><tech-state wx:if="{{!rows.length}}" title="还没有报价" description="根据现场检测记录，选择服务项目与价格规则。保存后由服务端计算准确金额。" />
 <view wx:for="{{rows}}" wx:key="uid" class="tech-card quote-card"><view class="tech-summary-bar"><view class="quote-card__title">{{item.typeText}} <text class="quote-version">V{{item.quote.versionNo}}</text></view><text class="tech-tag {{item.quote.status==='ACCEPTED'?'tech-tag--green':item.quote.status==='DRAFT'?'tech-tag--muted':''}}">{{item.stateText}}</text></view><view class="quote-card__number">{{item.quote.quoteNo}}</view>
  <view class="quote-ledger"><view class="quote-ledger__row"><text>此前已确认</text><text>¥ {{item.quote.confirmedAmountBefore}}</text></view><view class="quote-ledger__row"><text>{{item.quote.quoteType==='ADDITIONAL'?'本次追加':'本次报价'}}</text><text>¥ {{item.quote.currentAdditionalAmount}}</text></view><view class="quote-ledger__total"><text>确认后累计应付</text><text>¥ {{item.quote.payableTotalAfterAcceptance}}</text></view></view>
  <view wx:if="{{item.quote.status==='DRAFT'}}" class="tech-caption">草稿金额尚未得到客户确认，不属于已接受维修范围。</view>
  <view wx:for="{{item.lines}}" wx:for-item="line" wx:key="id" class="quote-line"><view><view class="quote-line__name">{{line.itemName}}</view><text class="quote-line__meta">{{line.feeText}} · {{line.quantity}} {{line.unit}} × ¥{{line.unitPrice}}</text><view wx:if="{{line.specification}}" class="quote-line__meta">{{line.specification}}</view><view wx:if="{{line.partSourceNote}}" class="quote-line__meta">配件来源：{{line.partSourceNote}}</view></view><text class="quote-line__amount">¥{{line.amount}}</text></view>
  <view wx:if="{{item.quote.changeReason}}" class="quote-reason">报价依据：{{item.quote.changeReason}}</view><view class="quote-expiry"><van-icon name="clock-o" size="12px" /> 有效期至 {{item.expiryText}}</view>
  <view wx:if="{{item.approval}}" class="quote-approval"><view class="quote-approval__title"><van-icon name="shield-o" /> {{item.approvalText}}</view><view>{{item.approval.overrideReason}}</view><view wx:if="{{item.approval.reviewComment}}">审批意见：{{item.approval.reviewComment}}</view></view>
  <view wx:if="{{item.canOverride}}" class="tech-notice">本版报价超出平台价格区间，请申请审批。审批通过后可提交客户确认。</view>
  <view wx:elif="{{item.quote.status==='DRAFT' && item.approval.status==='PENDING'}}" class="tech-notice">已申请超区间审批，等待管理端审核。</view>
  <view wx:if="{{!pendingLabel&&(item.canEdit||item.canSubmit||item.canOverride||item.canWithdraw)}}" class="quote-actions"><button wx:if="{{item.canWithdraw}}" class="tech-btn tech-btn--outline tech-btn--small" data-id="{{item.quote.id}}" data-action="withdraw" bindtap="onAction" disabled="{{busy}}">撤回</button><button wx:if="{{item.canEdit}}" class="tech-btn tech-btn--outline tech-btn--small" data-id="{{item.quote.id}}" bindtap="onEdit" disabled="{{busy}}">编辑草稿</button><button wx:if="{{item.canOverride}}" class="tech-btn tech-btn--soft tech-btn--small" data-id="{{item.quote.id}}" data-action="override-approvals" bindtap="onAction" disabled="{{busy}}">申请超区间审批</button><button wx:if="{{item.canSubmit}}" class="tech-btn tech-btn--primary tech-btn--small" data-id="{{item.quote.id}}" data-action="submit" bindtap="onAction" disabled="{{busy}}">提交客户确认</button></view>
 </view><view class="tech-bottom-note">已确认报价与历史版本保留，不覆盖、不删改</view></block><view wx:if="{{commandError}}" class="tech-form-error">{{commandError}}</view><view wx:if="{{pendingLabel||canCreate}}" class="tech-dock"><button wx:if="{{pendingLabel}}" class="tech-btn tech-btn--primary" loading="{{busy}}" disabled="{{busy}}" bindtap="onRetry">恢复“{{pendingLabel}}”结果</button><button wx:elif="{{canCreate}}" class="tech-btn tech-btn--primary" bindtap="onCreate">{{rejectionFollowUp==='WAITING_QUOTE'?'重新报价':additional?'发起追加报价':'填写初始报价'}}</button></view></view>
