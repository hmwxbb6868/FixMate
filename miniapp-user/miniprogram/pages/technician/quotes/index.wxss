@import "../../../styles/technician.wxss";
.quote-order{margin:-10rpx 4rpx 24rpx;word-break:break-all;}.quote-card__title{font-size:29rpx;font-weight:700;}.quote-version{font-size:22rpx;color:#A3ABB6;font-weight:500;margin-left:8rpx;}.quote-card__number{font-size:20rpx;color:#ABB1BB;margin:8rpx 0 24rpx;word-break:break-all;}.quote-ledger{background:#FAF7F3;border-radius:18rpx;padding:22rpx;margin:20rpx 0;}.quote-ledger__row{display:flex;align-items:center;justify-content:space-between;font-size:25rpx;color:#8D7D70;margin-bottom:16rpx;}.quote-ledger__row text:last-child{color:#6B5A4D;font-variant-numeric:tabular-nums;}.quote-ledger__total{display:flex;align-items:center;justify-content:space-between;border-top:1rpx dashed #EADCD0;padding-top:20rpx;font-size:25rpx;color:#78543D;}.quote-ledger__total text:last-child{font-size:37rpx;line-height:1.3;font-weight:750;color:#C84D1D;}.quote-line{padding:22rpx 0;display:flex;justify-content:space-between;gap:20rpx;border-bottom:1rpx solid #F0F1F4;}.quote-line>view{flex:1;min-width:0;}.quote-line__name{font-size:27rpx;font-weight:600;}.quote-line__meta{font-size:22rpx;color:#929AA6;margin-top:8rpx;word-break:break-word;}.quote-line__amount{font-size:27rpx;color:#5B6777;white-space:nowrap;}.quote-reason{font-size:24rpx;color:#7F8995;line-height:1.8;padding:20rpx 0 0;}.quote-expiry{display:flex;align-items:center;gap:10rpx;color:#A0A7B0;font-size:22rpx;margin-top:20rpx;}.quote-approval{padding:20rpx;background:#F4F7FC;border-radius:14rpx;font-size:24rpx;color:#8290A5;margin-top:20rpx;line-height:1.8;}.quote-approval__title{color:#58739A;font-weight:600;margin-bottom:8rpx;}.quote-actions{display:flex;flex-wrap:wrap;gap:14rpx;justify-content:flex-end;border-top:1rpx solid #F0F1F4;padding-top:24rpx;margin-top:24rpx;}
