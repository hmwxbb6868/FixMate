@import "../../../styles/technician.wxss";
.task-hero{padding:30rpx;background:linear-gradient(120deg,#FFF0E3,#FFF8F2);border-radius:26rpx;margin-bottom:26rpx;border:1rpx solid #F8E9DF;}.task-hero__eyebrow{color:#A2816E;font-size:22rpx;}.task-hero__title{font-size:44rpx;font-weight:750;margin-top:18rpx;}.task-hero__no{font-size:21rpx;color:#B19A8B;word-break:break-all;margin-top:8rpx;}.task-hero__hint{font-size:26rpx;color:#96705A;margin-top:20rpx;line-height:1.8;}.task-private{font-size:20rpx;font-weight:400;margin-left:auto;color:#9CA5B1;}.task-call{display:flex;align-items:center;justify-content:center;flex:0 0 68rpx;width:68rpx;min-width:68rpx;max-width:68rpx;height:68rpx;min-height:68rpx;border:0;border-radius:50%;background:#FFF0E7;color:#D34B18;padding:0;margin:0;line-height:1;box-sizing:border-box;}.task-privacy{font-size:24rpx;color:#939CA9;display:flex;gap:10rpx;align-items:center;margin:24rpx 6rpx;}.quote-entry{display:flex;align-items:center;gap:22rpx;}.quote-entry__icon{width:78rpx;height:78rpx;border-radius:24rpx;background:#EDF3FF;color:#6984B1;display:flex;align-items:center;justify-content:center;flex-shrink:0;}.quote-entry__body{flex:1;}.quote-entry__title{font-size:29rpx;font-weight:600;margin-bottom:5rpx;}.quote-entry .tech-muted{font-size:23rpx;}.task-return{font-size:24rpx;color:#979FAB;background:transparent;padding:18rpx;margin:10rpx auto;line-height:1.5;}.record-facts{font-size:26rpx;line-height:1.8;color:#6C7888;white-space:pre-wrap;word-break:break-word;margin-top:14rpx;padding:18rpx;background:#F7F8FA;border-radius:12rpx;}

.contact-phone-row{align-items:center;gap:20rpx;}
.contact-phone-row>.tech-row__label{flex:0 0 126rpx;}
.contact-phone-value{display:inline-flex;align-items:center;justify-content:flex-end;flex:0 0 auto;margin-left:auto;text-align:right;}
.contact-phone-number{white-space:nowrap;word-break:normal;font-size:29rpx;line-height:1.6;color:#334052;font-variant-numeric:tabular-nums;letter-spacing:.5rpx;}
.contact-phone-value>button.task-call{margin:0 0 0 14rpx!important;}
.task-call::after{border:0;}
