<view class="tech-page"><view class="tech-head"><view><view class="tech-title">我的工单</view><view class="tech-subtitle">{{tab==='CURRENT'?'每个任务，都有清晰的下一步':'查看自己参与过的服务记录'}}</view></view><view class="orders-count" wx:if="{{!loading&&!error}}">{{total}}<text>{{tab==='CURRENT'?'当前任务':'参与记录'}}</text></view></view>
 <view class="tech-tabs"><view class="tech-tab {{tab==='CURRENT'?'tech-tab--active':''}}" data-tab="CURRENT" bindtap="onTab">当前任务</view><view class="tech-tab {{tab==='HISTORY'?'tech-tab--active':''}}" data-tab="HISTORY" bindtap="onTab">历史参与</view></view>
 <block wx:if="{{tab==='CURRENT'}}"><view class="tech-search"><van-icon name="search" size="18px" /><input placeholder="搜索当前任务编号、设备或故障" value="{{keyword}}" bindinput="onSearch" /></view><scroll-view scroll-x enhanced show-scrollbar="{{false}}"><view class="tech-chips"><view wx:for="{{filters}}" wx:key="key" class="tech-chip {{filter===item.key?'tech-chip--active':''}}" data-filter="{{item.key}}" bindtap="onFilter">{{item.text}}</view></view></scroll-view></block>
 <tech-state wx:if="{{loading}}" loading />
 <tech-state wx:elif="{{error}}" error title="{{denied?'维修授权不可用':'工单暂未同步'}}" description="{{error}}" action="重新读取" bind:retry="refresh" />
 <block wx:elif="{{tab==='CURRENT'}}"><tech-task-card wx:for="{{items}}" wx:key="id" task="{{item}}" bind:open="onTask" /><tech-state wx:if="{{!items.length}}" title="{{keyword?'没有匹配的当前任务':filter==='PENDING'?'暂无待确认派单':'暂无这类任务'}}" description="{{keyword?'换个编号、设备或故障关键词试试。':filter==='PENDING'?'平台定向派给你的任务会显示在这里。':'自主接下或平台分派的任务会显示在这里。'}}" /></block>
 <block wx:else><view class="history-note"><van-icon name="shield-o" size="14px" /> 历史仅展示本人参与摘要，客户资料已隐藏</view><view wx:for="{{history}}" wx:key="workOrderId" class="tech-card history-card" data-id="{{item.workOrderId}}" bindtap="onHistory"><view class="tech-summary-bar"><text class="history-title">{{item.title}}维修</text><text class="tech-tag tech-tag--muted">{{item.stateText}}</text></view><view class="history-no">{{item.workOrderNo}}</view><view wx:if="{{item.cancellationFeeAmount}}" class="history-summary">应收上门费 ¥{{item.cancellationFeeAmount}}</view><view wx:elif="{{item.acceptanceText}}" class="history-summary">{{item.acceptanceText}}</view><view class="history-foot"><text>{{item.timeText}}</text><van-icon name="arrow" size="12px" /></view></view><tech-state wx:if="{{!history.length}}" title="暂时没有参与记录" description="参与过的任务会保留在这里，方便回顾。" /><view wx:if="{{loadingMore}}" class="tech-bottom-note">正在读取更多记录…</view><button wx:elif="{{moreError}}" class="tech-link" bindtap="onReachBottom">{{moreError}}，轻触重试</button><view wx:elif="{{history.length&&!historyMore}}" class="tech-bottom-note">已显示全部参与记录</view></block>
 <button wx:if="{{denied}}" class="tech-btn tech-btn--outline" bindtap="onUser">返回用户工作区</button>
</view>
