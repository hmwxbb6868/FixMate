@import "../../../styles/technician.wxss";
.desk-overview{background:linear-gradient(120deg,#FFF1E5 0%,#FFF8F2 68%,#FFF 100%);border:1rpx solid #F8E8DC;border-radius:28rpx;padding:30rpx 28rpx 26rpx;overflow:hidden;}.desk-overview__top{display:flex;align-items:center;justify-content:space-between;}.desk-overview__title{font-size:29rpx;font-weight:700;color:#653A27;}.desk-overview__sub{font-size:22rpx;color:#AC8065;margin-top:8rpx;}.desk-overview__seal{width:70rpx;height:70rpx;background:rgba(255,255,255,.75);border-radius:24rpx;display:flex;align-items:center;justify-content:center;color:#E8A06E;transform:rotate(8deg);}.desk-metrics{display:flex;margin-top:32rpx;padding-top:8rpx;}.desk-metric{flex:1;display:flex;flex-direction:column;align-items:center;gap:8rpx;font-size:24rpx;color:#8D725F;border-right:1rpx solid #F1E1D5;}.desk-metric:last-child{border-right:0;}.desk-metric__number{font-size:58rpx;line-height:1.25;font-weight:750;color:#C54C1E;font-variant-numeric:tabular-nums;}.desk-tip{display:flex;align-items:flex-start;gap:12rpx;padding:22rpx 6rpx 0;color:#A08B7E;font-size:23rpx;line-height:1.7;}.desk-tip van-icon{margin-top:4rpx;}.desk-count{font-size:23rpx;color:#B7BDC5;font-weight:400;margin-left:8rpx;}.desk-clear{padding:28rpx;display:flex;align-items:center;gap:22rpx;border-radius:24rpx;background:#FFF;color:#72A18C;}.desk-clear view view{font-size:28rpx;color:#5D6E63;}.desk-clear text{display:block;font-size:24rpx;color:#98A69D;margin-top:8rpx;}

.desk-pool{display:flex;align-items:center;gap:20rpx;padding:28rpx;background:#FFF;border:1rpx solid #F3E7DF;border-radius:26rpx;margin-top:24rpx;}.desk-pool__icon{background:#FFF1E5;color:#DF7941;width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:23rpx;}.desk-pool__body{flex:1;min-width:0;}.desk-pool__body view{font-size:31rpx;color:#343D4C;font-weight:700;}.desk-pool__body text{font-size:22rpx;color:#9A9FAA;display:block;margin-top:8rpx;}.desk-pool__go{display:flex;align-items:center;gap:8rpx;color:#D8521D;font-size:26rpx;font-weight:600;flex-shrink:0;}
