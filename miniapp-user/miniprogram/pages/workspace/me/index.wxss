@import "../../../styles/technician.wxss";
@import "../../../styles/records.wxss";

/* 资料只出现一次：统一左右行，不叠头像简介和重复昵称。 */
.profile-list { padding:4rpx 28rpx; background:var(--fm-bg-surface); border-radius:var(--fm-radius-lg); box-shadow:var(--fm-shadow-card); }
.profile-row {
  display:flex;
  align-items:center;
  gap:32rpx;
  min-height:116rpx;
  padding:28rpx 0;
  border-bottom:1rpx solid var(--fm-divider);
}
.profile-row--avatar { min-height:184rpx; padding:32rpx 0; }
.profile-row:last-child { border-bottom:0; }
.profile-row--link:active { background:var(--fm-bg-subtle); }
.profile-row__label { display:block; flex:0 0 112rpx; color:var(--fm-text-primary); font-size:var(--fm-font-body); }
.profile-row__hint { display:block; margin-top:8rpx; font-size:var(--fm-font-micro); line-height:32rpx; color:var(--fm-text-secondary); }
.profile-row__value { display:flex; flex:1; min-width:0; justify-content:flex-end; align-items:center; gap:20rpx; }
.profile-row__value > van-icon { display:block; flex-shrink:0; }
.profile-avatar { display:block; width:120rpx; height:120rpx; flex:0 0 120rpx; border-radius:50%; }
.profile-avatar--default { display:flex; align-items:center; justify-content:center; background:var(--fm-action-soft); color:var(--fm-action); }
/* 原生button显式固定宽度，避免默认布局把头像和旁边内容撑散。 */
.profile-avatar-button {
  display:block;
  flex:0 0 120rpx;
  width:120rpx;
  height:120rpx;
  min-height:0;
  margin:0;
  padding:0;
  border:0;
  border-radius:50%;
  background:transparent;
  line-height:0;
  overflow:hidden;
}
.profile-avatar-button::after { border:none; }
.profile-nickname { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; text-align:right; font-size:var(--fm-font-body); color:var(--fm-text-secondary); }
.profile-placeholder { color:var(--fm-text-tertiary); }
.profile-nickname-input { width:100%; min-width:0; height:60rpx; padding:0; font-size:var(--fm-font-body); line-height:60rpx; text-align:right; color:var(--fm-text-primary); }
.profile-feedback { display:flex; align-items:center; flex-wrap:wrap; gap:16rpx; margin:20rpx 0 0; font-size:var(--fm-font-caption); line-height:var(--fm-line-caption); color:var(--fm-text-secondary); }
.profile-feedback--error { color:var(--fm-danger); }
.profile-upload-retry { flex-shrink:0; }
.profile-actions { display:flex; gap:20rpx; padding:28rpx 0 24rpx; }
.profile-actions__cell { flex:1; min-width:0; }
.profile-actions__cell > van-button { display:block; width:100%; }

.profile-workspace { margin-top:24rpx; padding:26rpx 28rpx; background:var(--fm-hero); border:1rpx solid var(--fm-warm-line); border-radius:var(--fm-radius-lg); display:flex; align-items:center; justify-content:space-between; gap:20rpx; color:var(--fm-action); }
.profile-workspace__title { font-size:var(--fm-font-body); font-weight:700; color:var(--fm-text-primary); }
.profile-workspace__hint { font-size:var(--fm-font-caption); color:var(--fm-warm-text); margin-top:6rpx; }
.profile-workspace > text { flex-shrink:0; font-size:25rpx; }
.staff-profile-card{padding:32rpx;background:linear-gradient(120deg,#FFF0E2,#FFFAF5);border:1rpx solid #F8E8DA;border-radius:28rpx;margin-bottom:26rpx;}.staff-profile-top{display:flex;align-items:center;gap:24rpx;}.staff-avatar{width:120rpx;height:120rpx;border-radius:36rpx;background:#FFE3CB;color:#D57A42;display:flex;align-items:center;justify-content:center;flex-shrink:0;}.staff-profile-body{min-width:0;}.staff-name{font-size:38rpx;font-weight:750;color:#573E31;word-break:break-all;}.staff-phone{font-size:25rpx;color:#AF8C76;margin-top:8rpx;}.staff-role{display:flex;align-items:center;gap:8rpx;font-size:22rpx;color:#BD7A4C;margin-top:12rpx;}.staff-profile-bottom{border-top:1rpx solid #F1DFD1;display:flex;justify-content:flex-end;gap:16rpx;margin-top:28rpx;padding-top:22rpx;font-size:21rpx;color:#B3937C;}.staff-shortcuts{display:flex;background:#FFF;border-radius:24rpx;padding:28rpx 12rpx;}.staff-shortcuts>view{flex:1;text-align:center;font-size:25rpx;color:#707C8B;}.staff-shortcut-icon{width:82rpx;height:82rpx;background:#FFF1E8;color:#D48654;border-radius:26rpx;display:flex;align-items:center;justify-content:center;margin:0 auto 14rpx;}.staff-shortcut-icon--blue{background:#EDF3FE;color:#7390B9;}.staff-shortcut-icon--green{background:#EDF7F1;color:#79A18D;}.staff-menu{display:flex;align-items:center;gap:24rpx;padding:28rpx;border-bottom:1rpx solid #F0F1F4;}.staff-menu:last-child{border-bottom:0;}.staff-menu>view{flex:1;}.staff-menu>view>text{font-size:28rpx;font-weight:600;}.staff-menu>view>view{font-size:23rpx;color:#A0A8B3;margin-top:8rpx;}.staff-switch{display:flex;align-items:center;justify-content:center;gap:16rpx;width:100%;padding:24rpx;line-height:1.5;font-size:27rpx;color:#97654A;background:#FFF;border-radius:20rpx;border:1rpx solid #EBE2DB;margin:0;}.staff-switch text{flex:1;text-align:left;}

.staff-phone-source{font-size:20rpx;color:#B39988;margin-top:4rpx;}.staff-process{display:flex;justify-content:space-between;text-align:center;gap:12rpx;}.staff-process>view{flex:1;}.staff-process text{color:#DEA27A;font-size:24rpx;font-weight:700;}.staff-process view view{font-size:23rpx;color:#6F7A87;margin-top:10rpx;}.staff-process-note{font-size:23rpx;color:#9BA4AF;line-height:1.8;border-top:1rpx solid #F0F1F4;padding-top:22rpx;margin-top:24rpx;}
