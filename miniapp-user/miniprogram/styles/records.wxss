.records-page { min-height:100vh; background:var(--fm-bg-page); padding:24rpx 28rpx calc(80px + env(safe-area-inset-bottom)); }
.records-head { padding:16rpx 4rpx 28rpx; }
.records-head--summary { padding:28rpx 30rpx; margin-bottom:24rpx; border:1rpx solid var(--fm-warm-line); border-radius:var(--fm-radius-lg); background:var(--fm-hero); }
.records-title { font-size:var(--fm-font-title); font-weight:700; line-height:var(--fm-line-title); overflow-wrap:anywhere; }
.records-subtitle { font-size:var(--fm-font-caption); color:var(--fm-text-secondary); margin-top:8rpx; overflow-wrap:anywhere; }
.records-state { margin-top:18rpx; padding:70rpx 28rpx; text-align:center; color:var(--fm-text-secondary); background:var(--fm-bg-surface); border-radius:var(--fm-radius-lg); box-shadow:var(--fm-shadow-card); }
.records-state van-button { display:block; margin-top:24rpx; }
.records-note { margin:0 0 22rpx; padding:20rpx 24rpx; border:1rpx solid var(--fm-warm-line); border-radius:var(--fm-radius-md); background:var(--fm-action-soft); color:var(--fm-warm-text); font-size:var(--fm-font-caption); }
.records-entry,
.records-card { margin-bottom:20rpx; background:var(--fm-bg-surface); border-radius:var(--fm-radius-lg); box-shadow:var(--fm-shadow-card); }
.records-entry { padding:24rpx 28rpx 18rpx; }
.records-entry--pressed { background:var(--fm-bg-subtle); }
.records-entry__top { display:flex; align-items:center; gap:14rpx; }
.records-entry__icon { display:flex; align-items:center; justify-content:center; flex:0 0 58rpx; height:58rpx; color:var(--fm-action); background:var(--fm-action-soft); border-radius:var(--fm-radius-md); }
.records-entry__title { flex:1; min-width:0; font-size:var(--fm-font-body); font-weight:700; overflow-wrap:anywhere; }
.records-status { flex-shrink:0; max-width:42%; padding:4rpx 12rpx; border-radius:var(--fm-radius-sm); font-size:23rpx; font-weight:600; line-height:1.45; color:var(--fm-action); background:var(--fm-action-soft); text-align:center; }
.records-status--success { color:var(--fm-success); background:var(--fm-success-soft); }
.records-status--quiet { color:var(--fm-text-secondary); background:var(--fm-bg-subtle); }
.records-summary { font-size:var(--fm-font-body); color:var(--fm-text-secondary); margin:14rpx 0 18rpx; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; word-break:break-word; }
.records-meta { font-size:24rpx; color:var(--fm-text-tertiary); font-variant-numeric:tabular-nums; }
.records-entry__foot { display:flex; align-items:center; justify-content:space-between; border-top:1rpx solid var(--fm-divider); padding-top:14rpx; }
.records-foot { padding:10rpx 20rpx 24rpx; text-align:center; color:var(--fm-text-secondary); font-size:var(--fm-font-caption); }
.records-card { padding:4rpx 28rpx; }
.records-field { padding:20rpx 0; border-bottom:1rpx solid var(--fm-divider); }
.records-field:last-child { border-bottom:0; }
.records-field__label { font-size:var(--fm-font-caption); color:var(--fm-text-secondary); margin-bottom:8rpx; }
.records-field__value { white-space:pre-wrap; word-break:break-word; }
.records-actions { display:flex; flex-direction:column; gap:14rpx; margin-top:24rpx; }
.records-gallery { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:12rpx; }
.records-gallery > .records-meta { flex-basis:100%; }
.records-photo { width:calc((100% - 24rpx) / 3); height:184rpx; border-radius:var(--fm-radius-sm); background:var(--fm-bg-subtle); }

