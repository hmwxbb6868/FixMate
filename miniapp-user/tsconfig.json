{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": ["miniprogram-api-typings"],
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@fixmate/api-contract": ["../packages/api-contract/typescript/dist/index.d.ts"],
      "@vant/weapp/*": ["node_modules/@vant/weapp/lib/*"]
    }
  },
  "include": ["miniprogram/**/*.ts", "miniprogram/**/*.d.ts"],
  "exclude": ["node_modules", "miniprogram_npm"]
}
